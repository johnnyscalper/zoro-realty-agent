# Copy this file to .env. Keep real keys on your own computer/server.
# Portal 일반 인증키(Decoding) is recommended. Do not add quotes unless needed.
MOLIT_TRADE_API_KEY=
MOLIT_RENT_API_KEY=
# If both subscriptions use the same key, this fallback is also supported.
MOLIT_API_KEY=
MOLIT_TIMEOUT_SECONDS=10

# Optional model mode. Real Zoro protocol/model ID must be supplied by the host.
# Current adapter assumes an OpenAI Chat Completions compatible server.
# Use the actual server URL and model ID; never put these in chat messages.
ZORO_BASE_URL=
ZORO_MODEL=
ZORO_API_KEY=
ZORO_TIMEOUT_SECONDS=15

APP_HOST=127.0.0.1
APP_PORT=8000
# Optional local SQLite path; blank uses .runtime/realty.sqlite3.
STATE_DB_PATH=
